<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="300.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.UserProfileController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="User Profile">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <ImageView fx:id="profileImageView" fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
        <Label fx:id="usernameLabel" text="Username:">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <Button fx:id="uploadButton" mnemonicParsing="false" onAction="#onUploadClick" prefWidth="200.0" text="Upload New Picture" />
        <Label fx:id="statusLabel" textFill="GREEN" />
    </children>
</VBox>