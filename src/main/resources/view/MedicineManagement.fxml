<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.MedicineManagementController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="200.0" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
            <children>
                <Label text="Medicine Management">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>
    <center>
        <TableView fx:id="medicineTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="150.0" text="Name" />
                <TableColumn fx:id="batchNumberColumn" prefWidth="120.0" text="Batch Number" />
                <TableColumn fx:id="quantityColumn" prefWidth="80.0" text="Quantity" />
                <TableColumn fx:id="priceColumn" prefWidth="90.0" text="Unit Price" />
                <TableColumn fx:id="expiryDateColumn" prefWidth="120.0" text="Expiry Date" />
                <TableColumn fx:id="supplierColumn" prefWidth="150.0" text="Supplier" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" />
            </BorderPane.margin>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" prefHeight="60.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#onRefreshButtonClick" prefWidth="100.0" text="Refresh" />
                <Button fx:id="addButton" layoutX="570.0" layoutY="23.0" mnemonicParsing="false" onAction="#onAddButtonClick" prefWidth="100.0" text="Add" />
                <Button fx:id="editButton" layoutX="626.0" layoutY="23.0" mnemonicParsing="false" onAction="#onEditButtonClick" prefWidth="100.0" text="Edit" />
                <Button fx:id="deleteButton" layoutX="682.0" layoutY="23.0" mnemonicParsing="false" onAction="#onDeleteButtonClick" prefWidth="100.0" text="Delete" />
            </children>
        </HBox>
    </bottom>
</BorderPane>