<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.DashboardController">
    <left>
        <VBox prefHeight="200.0" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #f4f4f4;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="MedSync Menu">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>
                <Button fx:id="dashboardButton" mnemonicParsing="false" prefHeight="40.0" prefWidth="180.0" text="Dashboard" />
                <Button fx:id="manageMedicineButton" mnemonicParsing="false" onAction="#onManageMedicineClick" prefHeight="40.0" prefWidth="180.0" text="Manage Medicines" />
                <Button fx:id="manageUsersButton" mnemonicParsing="false" onAction="#onManageUsersClick" prefHeight="40.0" prefWidth="180.0" text="Manage Users" />
                <Button fx:id="reportsButton" mnemonicParsing="false" onAction="#onReportsButtonClick" prefHeight="40.0" prefWidth="180.0" text="Generate Reports" />
                <Button fx:id="profileButton" layoutX="20.0" layoutY="184.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="180.0" text="User Profile" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label text="System Dashboard">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>
                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Low Stock Alerts (Under 10)">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <TableView fx:id="lowStockTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="lowStockNameCol" prefWidth="75.0" text="Name" />
                                        <TableColumn fx:id="lowStockQtyCol" prefWidth="75.0" text="Quantity" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Expiring Soon (Next 30 Days)">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <TableView fx:id="expiryTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="expiryNameCol" prefWidth="75.0" text="Name" />
                                        <TableColumn fx:id="expiryDateCol" prefWidth="75.0" text="Expiry Date" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>